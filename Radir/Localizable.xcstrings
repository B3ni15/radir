        }
      }
    },
    "Több fiókot is hozzáadhatsz, és egy koppintással válthatsz." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mehrere Konten hinzufügen und mit einem Tippen wechseln."
