        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add several accounts and switch with one tap."
          }
        }
      }
    },
    "Több mint 20 jó jegy kellene hozzá. Próbálj kisebb célt." : {
