    "Több egyes is becsúszott. Jövőre jobb lesz!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar Einser haben sich eingeschlichen. Nächstes Jahr wird besser!"
