      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radír trägt deinen Stundenplan in einen eigenen „Radír“-Kalender ein, wenn du die Kalendersynchronisierung einschaltest."
